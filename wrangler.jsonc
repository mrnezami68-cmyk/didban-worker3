{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "market-ai-interpreter",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],

  // اتصال مستقیم هوش مصنوعی لبه کلودفلر
  "ai": {
    "binding": "AI"
  },

  "observability": {
    "enabled": true
  }
}
